# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (used by the db container and to build the backend's DB URLs) ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker
# A second database, <POSTGRES_DB>_test, is created automatically for pytest.

# --- Backend ---
# Generate a long random value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata

# Protects POST /api/internal/reminders/run. Any long random string.
CRON_SECRET=replace-with-another-long-random-string

# --- Email ---
# Locally, docker-compose points SMTP at Mailpit (open http://localhost:8025 to read mail).
# In production set EMAIL_PROVIDER=brevo and BREVO_API_KEY (see docs/DEPLOY.md).
EMAIL_FROM_NAME=Personal Tracker
EMAIL_FROM_ADDRESS=reminders@tracker.local
